  {
    "type": "gram",
    "at": 1791830343470,
    "title": "Particle は (topic)",
    "jp": "A は B です",
    "body": "は marks the topic of the sentence: “as for A, it is B”. As a particle it is pronounced “wa”, not “ha”.\nです works as the polite verb “to be” and goes at the end of the sentence.",
    "examples": [
      {
        "jp": "わたしはがくせいです。",
        "ca": "I am a student."
      },
      {
        "jp": "これはねこです。",
        "ca": "This is a cat."
      }
    ]
  },
  {
    "type": "frase",
    "at": 1791830343469,
    "jp": "日本語を勉強しています。",
    "kana": "にほんごをべんきょうしています。",
    "romaji": "nihongo o benkyō shite imasu.",
    "ca": "I am studying Japanese.",
    "body": "〜ています expresses an action in progress."
  },
  {
    "type": "gram",
    "at": 1791830343468,
    "title": "Particle の (possession)",
    "jp": "A の B",
    "body": "の joins two nouns: “A's B”. The order is the same as with the English 's.",
    "examples": [
      {
        "jp": "せんせいのほん",
        "ca": "the teacher's book"
      },
      {
        "jp": "にほんのやま",
        "ca": "the mountains of Japan"
      }
    ]
  }
]
